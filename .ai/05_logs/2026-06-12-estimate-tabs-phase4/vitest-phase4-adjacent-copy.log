+     quantity: 1,
+     subTotal: 0,
+     contingencyPercentage: 0,
+     contingencyValue: 0,
+     miscCost: 0,
+     totalItemCosts: 0,
+     category: "Unassigned",
+     tags: [BLANK_ESTIMATE_ROW_TAG],
+     pricingSource: "Manual estimate row",
+     pricingDate: new Date().toISOString().slice(0, 10),
+     confidence: "unpriced",
+   };
+ }
