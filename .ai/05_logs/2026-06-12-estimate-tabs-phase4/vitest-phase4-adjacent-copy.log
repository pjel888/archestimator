+     ? `${forwardedProto ?? (requestHost.startsWith("localhost") ? "http" : "https")}://${requestHost}`
+     : null;
+
+   return resolveAllowedAuthOrigin({
+     requestOrigin: headerList.get("origin"),
+     requestUrl,
+   });
+ }
