  "criteria": [
    {
      "id": "AC-001",
      "status": "BOUNDARY",
      "artifact_path": "units/001-action-inbox-async-server-actions.md",
      "test_requirement": "TEST_PROPOSAL",
      "test_trigger": "MVP_CRITICAL_INVARIANT",
      "test_rationale": "The 'use server' async contract is a critical build invariant; cheaper non-test evidence (source inspection) cannot prove at runtime that bun run build exits 0 and the previously-500 routes serve 200, so a build + route-reach regression test is the cheapest decisive evidence that the invariant holds.",
      "requirement_ids": [
        "UX-001"
      ],
      "test_ids": [],
      "evidence_ids": [
        "EVID-001"
      ],
      "authorization_boundary_id": "AUTH-001"
    },
    {
      "id": "AC-002",
      "status": "BOUNDARY",
      "artifact_path": "units/002-closed-beta-lead-capture.md",
      "test_requirement": "TEST_PROPOSAL",
      "test_trigger": "MVP_CRITICAL_INVARIANT",
      "test_rationale": "Server-side lead capture is a critical pre-recruiting invariant; cheaper non-test evidence (source inspection) cannot prove the new POST handler actually persists and that the closed-beta gate submits successfully at runtime, so a regression test asserting a D1 row is written is the cheapest decisive evidence that the invariant holds.",
      "requirement_ids": [
        "UX-002"
      ],
      "test_ids": [],
      "evidence_ids": [
        "EVID-003"
      ],
      "authorization_boundary_id": "AUTH-001"
    },
    {
      "id": "AC-003",
      "status": "BOUNDARY",
      "artifact_path": "units/003-landing-cta-unification.md",
      "test_requirement": "TEST_PROPOSAL",
      "test_trigger": "MVP_CRITICAL_INVARIANT",
      "test_rationale": "Header intent propagation is a critical analytics invariant for lead routing; cheaper non-test evidence (source inspection) cannot prove at runtime that the header CTA href includes an intent param when rendered on secondary pages, so a Playwright assertion against the rendered href is the cheapest decisive evidence that the invariant holds.",
      "requirement_ids": [
        "UX-003"
      ],
      "test_ids": [],
      "evidence_ids": [
        "EVID-004"
      ],
      "authorization_boundary_id": "AUTH-001"
    },
    {
      "id": "AC-004",
      "status": "BOUNDARY",
      "artifact_path": "units/004-remove-ab-experiment-wrapper.md",
      "test_requirement": "NOT_REQUIRED",
      "test_trigger": "NONE",
      "test_rationale": "A/B wrapper removal is a static-source change; source inspection is the cheapest decisive evidence that either no ABExperimentProvider wraps the landing page or a real variant assignment exists.",
      "requirement_ids": [
        "UX-004"
      ],
      "test_ids": [],
      "evidence_ids": [
        "EVID-004"
      ],
      "authorization_boundary_id": "AUTH-001"
    },
    {
      "id": "AC-005",
      "status": "BOUNDARY",
      "artifact_path": "units/005-first-estimate-checklist-publish.md",
      "test_requirement": "TEST_PROPOSAL",
      "test_trigger": "MVP_CRITICAL_INVARIANT",
      "test_rationale": "Checklist publish-row reachability is a critical activation invariant; cheaper non-test evidence (source inspection) cannot prove at runtime that the row is hidden or actionable on a fresh user session, so a vitest asserting no row is not_available for a no-milestone user is the cheapest decisive evidence that the invariant holds.",
      "requirement_ids": [
        "UX-005"
      ],
