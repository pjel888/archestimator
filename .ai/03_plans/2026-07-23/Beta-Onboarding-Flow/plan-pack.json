  "decisions": [
    {
      "id": "DEC-AUTO-001",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "UX-001",
        "UX-002",
        "UX-003",
        "UNIT-001",
        "UNIT-004",
        "UNIT-005",
        "UNIT-006"
      ],
      "rationale": "A short orientation, domain checklist, and route-local guides reach value without a brittle whole-application grand tour."
    },
    {
      "id": "DEC-AUTO-002",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "OPS-001",
        "PERF-001",
        "UNIT-001",
        "UNIT-003"
      ],
      "rationale": "Current Joyride v3 uncontrolled mode avoids external numeric-index drift and keeps the library state machine authoritative during a run."
    },
    {
      "id": "DEC-AUTO-003",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "UX-002",
        "DATA-002",
        "UNIT-002",
        "UNIT-004"
      ],
      "rationale": "Business activation must remain true independently of whether a user views or dismisses instructional UI."
    },
    {
      "id": "DEC-AUTO-004",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "DATA-001",
        "SEC-001",
        "UNIT-002"
      ],
      "rationale": "User, workspace, semantic flow, and version form the smallest durable scope that supports resume, upgrades, and tenant isolation."
    },
    {
      "id": "DEC-AUTO-005",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "DATA-001",
        "OPS-001",
        "UNIT-002"
      ],
      "rationale": "One state table and one append-only event table provide idempotency and diagnostics without creating a parallel workflow platform."
    },
    {
      "id": "DEC-AUTO-006",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "UX-001",
        "UX-003",
        "PERF-001",
        "UNIT-001",
        "UNIT-003",
        "UNIT-005",
        "UNIT-006"
      ],
      "rationale": "Rendering components can keep semantic target identifiers stable while allowing internal markup and responsive layout to evolve."
    },
    {
      "id": "DEC-AUTO-007",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "UX-001",
        "UX-003",
        "PERF-001",
        "UNIT-003",
        "UNIT-004",
        "UNIT-005",
        "UNIT-006"
      ],
      "rationale": "Route-local guides bound readiness, cancellation, recovery, and ownership better than one monolithic cross-route tour."
    },
    {
      "id": "DEC-AUTO-008",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "UX-002",
        "DATA-002",
        "UNIT-002",
        "UNIT-004",
        "UNIT-005"
      ],
      "rationale": "Authoritative project, estimate, activation, and total facts must complete value tasks; tooltip exposure cannot manufacture activation."
    },
    {
      "id": "DEC-AUTO-009",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "UX-004",
        "PERF-001",
        "UNIT-003",
        "UNIT-004"
      ],
      "rationale": "Mobile onboarding cannot truthfully target desktop-only navigation, so shared authorized mobile navigation is a prerequisite."
    },
    {
      "id": "DEC-AUTO-010",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "UX-004",
        "UNIT-003",
        "UNIT-004",
        "UNIT-005",
        "UNIT-007"
      ],
      "rationale": "Pausing the tour before an application modal opens prevents nested focus traps and ambiguous Escape or restoration behavior."
    },
    {
      "id": "DEC-AUTO-011",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "UX-004",
        "DATA-001",
        "UNIT-002",
        "UNIT-003",
        "UNIT-007"
      ],
      "rationale": "Resume, replay, restart, checklist reopen, and reset have different persistence consequences and therefore require distinct commands and copy."
    },
    {
      "id": "DEC-AUTO-012",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "SEC-001",
        "DATA-002",
        "UNIT-002",
        "UNIT-003",
        "UNIT-007"
      ],
      "rationale": "Semantic allowlisted telemetry supports recovery while excluding tenant content, resource identifiers, selectors, URLs, and free-form errors."
    },
    {
      "id": "DEC-AUTO-013",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "REQ-001",
        "OPS-001",
        "UNIT-001",
        "UNIT-008"
      ],
      "rationale": "The archived Supabase-era plan contains superseded architecture and cannot be executable authority for the current D1 application."
    },
    {
      "id": "DEC-AUTO-014",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "REQ-001",
        "UNIT-008",
        "GATE-VERIFY-01"
      ],
      "rationale": "Unrequested product tests remain explicit proposals and evidence gaps rather than artificial authorization or technical blockers."
    },
    {
      "id": "DEC-AUTO-015",
      "status": "ACTIVE",
      "artifact_path": "IMPLEMENTATION_PLAN.md",
      "affected_ids": [
        "UX-001",
        "SEC-001",
        "DATA-002",
        "UNIT-001",
        "UNIT-002",
        "UNIT-003",
        "UNIT-004",
        "UNIT-006"
      ],
      "rationale": "Current workspace, project, and estimate grants all confer legitimate access and must work without synthetic workspace membership."
    },
    {
      "id": "DEC-AUTO-016",
