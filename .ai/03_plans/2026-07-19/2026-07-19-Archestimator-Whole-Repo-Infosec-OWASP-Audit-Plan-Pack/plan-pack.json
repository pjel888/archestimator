  "criteria": [
    {
      "id": "AC-001",
      "status": "BOUNDARY",
      "artifact_path": "units/001-realtime-token-revocation.md",
      "test_requirement": "TEST_PROPOSAL",
      "test_trigger": "MVP_CRITICAL_INVARIANT",
      "test_rationale": "Revocation is the critical security invariant for realtime collaboration; cheaper non-test evidence (source inspection) cannot prove the DO SQLite denylist read and the alarm/cleanup interaction happen at runtime, so a runtime regression test is the cheapest decisive evidence that the invariant holds.",
      "requirement_ids": [
        "SEC-001"
      ],
      "test_ids": [],
      "evidence_ids": [
        "EVID-001"
      ],
      "authorization_boundary_id": "AUTH-001"
    },
    {
      "id": "AC-002",
      "status": "BOUNDARY",
      "artifact_path": "units/002-worker-edge-seam.md",
      "test_requirement": "TEST_PROPOSAL",
      "test_trigger": "MVP_CRITICAL_INVARIANT",
      "test_rationale": "The worker-edge seam is a critical invariant \u2014 public-internet reachability of admin-equivalent routes must be closed; cheaper non-test evidence (config inspection) cannot prove deployed DNS behavior, so the existing_test_path is insufficient and a hosted probe is the cheapest decisive evidence, which is why the criterion is BOUNDARY pending AUTH-004.",
      "requirement_ids": [
        "SEC-002"
      ],
      "test_ids": [],
      "evidence_ids": [
        "EVID-002"
      ],
      "authorization_boundary_id": "AUTH-004"
    },
    {
      "id": "AC-003",
      "status": "PASS",
      "artifact_path": "units/004-email-boundary-chokepoint.md",
      "test_requirement": "TEST_PROPOSAL",
      "test_trigger": "CHEAPEST_DECISIVE_EXISTING_TEST",
      "test_rationale": "Email boundary CRLF stripping is the critical invariant for safe email send; an existing vitest run is the cheapest decisive proof that the chokepoint strips CR/LF, and source inspection alone is insufficient because the EMAIL binding's runtime MIME construction cannot be verified statically.",
      "requirement_ids": [
        "SEC-003"
      ],
      "test_ids": [],
      "evidence_ids": [
        "EVID-003"
      ],
      "authorization_boundary_id": null
    },
    {
      "id": "AC-004",
      "status": "BOUNDARY",
      "artifact_path": "units/005-scan-bind-invariant.md",
