      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UX-001",
        "SEC-001",
        "SEC-002",
        "UNIT-004",
        "UNIT-005"
      ],
      "rationale": "A source-grounded proposal-and-execution loop gives conversational utility without making the model an authority or executor."
    },
    {
      "id": "DEC-AUTO-002",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "SEC-001",
        "SEC-002",
        "DATA-001",
        "UNIT-001",
        "UNIT-002"
      ],
      "rationale": "Authentication, policy, calculations, confirmations, D1 writes, and receipts are application invariants and cannot be delegated to a probabilistic provider."
    },
    {
      "id": "DEC-AUTO-003",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UX-001",
        "UNIT-004",
        "UNIT-005",
        "UNIT-006"
      ],
      "rationale": "One server route removes client privilege routing and allows the pre-beta package-builder route to be deleted after parity."
    },
    {
      "id": "DEC-AUTO-004",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "SEC-001",
        "SEC-002",
        "UNIT-001",
        "UNIT-003",
        "UNIT-006"
      ],
      "rationale": "An explicit typed registry makes every capability, permission, source rule, confirmation, executor, and prohibition reviewable."
    },
    {
      "id": "DEC-AUTO-005",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "SEC-003",
        "DATA-001",
        "UNIT-001",
        "UNIT-005"
      ],
      "rationale": "Persisting structured plans and receipts but not raw conversations preserves prior privacy decisions while supporting durable approval and recovery."
    },
    {
      "id": "DEC-AUTO-006",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UX-002",
        "DATA-001",
        "UNIT-002"
      ],
      "rationale": "The Rivera scenario needs one domain-owned aggregate command so project, estimate, tree, rows, history/outbox, and receipts share a transaction."
    },
    {
      "id": "DEC-AUTO-007",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "SEC-002",
        "DATA-001",
        "UNIT-001"
      ],
      "rationale": "The specialized apply-command table cannot represent general plan versions, approval binding, leases, policy state, and per-action receipts."
    },
    {
      "id": "DEC-AUTO-008",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "OPS-002",
        "UNIT-004",
        "UNIT-007"
      ],
      "rationale": "Current official docs make GPT-5.6 Terra the reasonable balanced integration target, but only the Archestimator corpus can lock the release model."
    },
    {
      "id": "DEC-AUTO-009",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "OPS-001",
        "AUTH-001",
        "UNIT-004",
        "UNIT-007"
      ],
      "rationale": "AI Gateway can supply transport observability and limits, but keeping correctness in the app avoids a provider-specific control-plane dependency."
    },
    {
      "id": "DEC-AUTO-010",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UX-002",
        "DATA-001",
        "UNIT-002",
        "UNIT-007"
      ],
      "rationale": "Construction estimate trust requires source-backed or explicitly reviewed values and one canonical server money calculation."
    }
