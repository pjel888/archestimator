  "decisions": [
    {
      "id": "DEC-AUTO-001",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UX-001",
        "UX-002",
        "UX-003",
        "SEC-001"
      ],
      "rationale": "Ask Flip is a professional workflow assistant; the model may answer or propose but never becomes the domain authority or autonomous executor."
    },
    {
      "id": "DEC-AUTO-002",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-001",
        "REQ-002",
        "UNIT-003",
        "UNIT-007"
      ],
      "rationale": "A hosted foundation model with runtime product knowledge and authorized retrieval meets the product need without training or fine-tuning."
    },
    {
      "id": "DEC-AUTO-003",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UX-001",
        "UX-002",
        "UX-003",
        "UNIT-004",
        "UNIT-005",
        "UNIT-006"
      ],
      "rationale": "Ask-only, draft-and-review, and package-create apply are separate releases so each authority increase is independently reviewable."
    },
    {
      "id": "DEC-AUTO-004",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UNIT-003",
        "UNIT-004",
        "UNIT-005",
        "UNIT-006",
        "RISK-001"
      ],
      "rationale": "One Ask route becomes the product surface while the legacy Package Builder remains dormant rather than supplying a broad mutation shortcut."
    },
    {
      "id": "DEC-AUTO-005",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "OPS-001",
        "SEC-001",
        "UNIT-001"
      ],
      "rationale": "Release profile and cohort entitlement constrain offered capability but never replace tool, target, source, or domain authorization."
    },
    {
      "id": "DEC-AUTO-006",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-001",
        "UX-001",
        "UNIT-002"
      ],
      "rationale": "Demand-driven typed reads plus versioned product knowledge provide bounded familiarity without broad retrieval infrastructure."
    },
    {
      "id": "DEC-AUTO-007",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "SEC-002",
        "UNIT-005",
        "UNIT-006"
      ],
      "rationale": "Canonical action plans live server-side and execute requests reload them by identifier rather than trusting a browser-resubmitted body."
    },
    {
      "id": "DEC-AUTO-008",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UX-003",
        "DATA-001",
        "UNIT-006"
      ],
      "rationale": "The first write surface is one additive project-and-estimate package domain command with no broader action families."
    },
    {
      "id": "DEC-AUTO-009",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "OPS-002",
        "UNIT-003",
        "UNIT-007"
      ],
      "rationale": "The first adapter uses OpenAI Responses through a provider-neutral application boundary; no second adapter is built without evaluation evidence."
    },
    {
      "id": "DEC-AUTO-010",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "OPS-002",
        "AUTH-002",
        "UNIT-003",
        "UNIT-007"
      ],
      "rationale": "Cloudflare AI Gateway is optional transport observability only and never owns authorization, plans, fallback, or correctness."
    },
    {
      "id": "DEC-AUTO-011",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-001",
        "SEC-001",
        "REQ-002",
        "UNIT-007"
      ],
      "rationale": "Later learning uses explicit structured preferences and accepted or edited decision signals, not raw-chat training or provider-owned memory."
    },
    {
      "id": "DEC-AUTO-012",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "DATA-001",
        "UX-003",
        "UNIT-006"
      ],
      "rationale": "All preview and receipt money uses the current canonical integer-minor-unit calculation path and authoritative workspace currency."
    }
