{
  "$schema": "https://archestimator.local/schemas/component-category-taxonomy.v2.json",
  "schemaVersion": 2,
  "version": "2026-05-22-draft-3",
  "status": "draft",
  "scope": "workshop-component-library",
  "intent": "Provide a clean browse taxonomy for reusable estimate row items, with top-level organizers, categories, and subcategories kept separate for reporting.",
  "principle": "The tree describes what the estimate row item is. Tags describe procurement scope, room, supplier, installer, standards crosswalk, and package ownership.",
  "rules": [
    "The nine top-level nodes are organizers only.",
    "The first child under an organizer is a reporting category.",
    "The next child under a category is a subcategory.",
    "Do not create blended category folders such as FF&E, Furniture and Equipment, Fixtures and Equipment, or Architectural and Interiors.",
    "FF&E means Furniture, Fixtures, and Equipment, but it is a procurement scope tag only.",
    "Furniture, Fixtures, and Equipment are always separate categories.",
    "Materials and Finishes are separate categories.",
    "Plumbing fixtures, sanitary fixtures, Plumbing Systems, and Sanitary Systems are separate categories.",
    "Lighting Fixtures and Lighting Systems are separate categories.",
    "Fire Protection, Fire Alarm, and Life Safety are separate categories."
  ],
  "governance": {
    "owner": "product-design",
    "reviewCadence": "review before taxonomy implementation and after first seeded-component mapping",
    "stability": "draft",
    "defaultVisibility": "core",
    "copyrightPolicy": "Store standards as optional crosswalk references. Do not embed licensed CSI, OmniClass, UniFormat, RICS, or other proprietary full tables without explicit license coverage."
  },
  "nodeTypes": ["organizer", "category", "subcategory"],
  "lifecycleStates": ["candidate", "core", "advanced", "deprecated", "archived"],
  "childEncoding": "Category children are subcategory labels. The runtime compiles each child into a stable node id for selection and filtering.",
  "views": {
    "tabs": [
      { "id": "categories", "label": "Categories", "purpose": "Primary browse tree for reusable estimate row categories." },
      { "id": "suppliers", "label": "Suppliers", "purpose": "Group by supplier, vendor, manufacturer, showroom, source, or quote." },
      { "id": "standards", "label": "Standards", "purpose": "Optional crosswalk view by CSI, UniFormat, OmniClass, Uniclass, NRM, cost code, or BIM category." }
    ],
    "primaryBrowseSections": [
      { "id": "administration", "label": "Administration", "rootIds": ["project-requirements", "temporary-works", "existing-conditions", "demolition"] },
      { "id": "site", "label": "Site", "rootIds": ["civil", "landscape", "exterior-works"] },
      { "id": "structure", "label": "Structure", "rootIds": ["foundations", "concrete-work", "reinforcement", "structural-steel", "structural-timber", "structural-masonry"] },
      { "id": "envelope", "label": "Envelope", "rootIds": ["roofing", "waterproofing", "exterior-walls", "exterior-cladding", "curtain-walls", "windows", "louvers", "exterior-shading", "insulation", "sealants"] },
      { "id": "architecture", "label": "Architecture", "rootIds": ["doors", "partitions", "interior-glazing", "ceilings", "stairs", "railings", "millwork", "casework", "specialties", "signage"] },
      { "id": "materials", "label": "Materials", "rootIds": ["concrete-material", "masonry-material", "stone", "tile-material", "wood", "metal", "glass-material", "gypsum", "plaster", "resin", "fabric", "composite-materials", "reclaimed-materials"] },
      { "id": "finishes", "label": "Finishes", "rootIds": ["floor-finishes", "wall-finishes", "ceiling-finishes", "countertop-finishes", "paint", "coatings", "tile-finishes", "wood-finishes", "finish-accessories"] },
      { "id": "objects", "label": "Objects", "rootIds": ["fixtures", "furniture", "equipment", "appliances", "electrical-devices", "controls", "faceplates", "accessories", "soft-furnishings", "window-treatments", "artwork", "decorative-objects"] },
      { "id": "systems", "label": "Systems", "rootIds": ["hvac", "plumbing-systems", "sanitary-systems", "stormwater-systems", "fuel-gas-systems", "electrical-power", "lighting-systems", "communications", "audio-visual", "security", "building-automation", "fire-protection", "fire-alarm", "life-safety", "vertical-transportation"] }
    ]
  },
