  "decisions": [
    {
      "id": "DEC-AUTO-001",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "PERF-001",
        "UNIT-001",
        "UNIT-003",
        "RISK-001"
      ],
      "rationale": "The existing shared server processor already handles both routes and is the correct single transform boundary."
    },
    {
      "id": "DEC-AUTO-002",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-001",
        "PERF-001",
        "UNIT-001",
        "UNIT-005",
        "RISK-001"
      ],
      "rationale": "Twelve MiB is the current common route and policy limit; removing the modal's unsupported 20 MiB promise is truthful and bounded."
    },
    {
      "id": "DEC-AUTO-003",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "SEC-001",
        "DATA-001",
        "UNIT-001",
        "RISK-002"
      ],
      "rationale": "A typed row-target mode in the existing project route removes duplicate POST code while preserving project-cover callers."
    },
    {
      "id": "DEC-AUTO-004",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "SEC-001",
        "DATA-001",
        "UNIT-001",
        "RISK-005"
      ],
      "rationale": "Project and workspace authorization remain separate even though processing, errors, and results are shared."
    },
    {
      "id": "DEC-AUTO-005",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "DATA-002",
        "UNIT-002",
        "UNIT-004",
        "UNIT-005",
        "RISK-004"
      ],
      "rationale": "A focused receipt-backed image mutation removes the unrelated hydrated-price-option precondition without weakening version or sync rules."
    },
    {
      "id": "DEC-AUTO-006",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UX-001",
        "UX-002",
        "UNIT-004",
        "UNIT-005"
      ],
      "rationale": "Existing targets can truthfully persist immediately; only targets that do not yet exist must retain a provisional descriptor."
    },
    {
      "id": "DEC-AUTO-007",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UX-001",
        "OPS-001",
        "UNIT-003",
        "UNIT-004",
        "UNIT-005",
        "RISK-003"
      ],
      "rationale": "Separating uploaded descriptor state from domain-save state permits safe save-only retry and prevents false success."
    },
    {
      "id": "DEC-AUTO-008",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "SEC-001",
        "DATA-001",
        "OPS-001",
        "UNIT-001",
        "RISK-005"
      ],
      "rationale": "Cloudflare Images or Sharp transform, R2 stores, D1 tracks, and authenticated brokers serve; no provider role is broadened."
    }
  ],
