      ],
      "rationale": "A same-area relation sidecar preserves the existing flat area row model while enabling assembly presentation without ambiguous area attribution."
    },
    {
      "id": "DEC-AUTO-002",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-002",
        "REQ-003",
        "RISK-004"
      ],
      "rationale": "Separate persistence plus one resolver keeps variant, alternative, optional, accessory, and proposal-scope meanings unambiguous."
    },
    {
      "id": "DEC-AUTO-003",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "DATA-001",
        "UNIT-002",
        "RISK-002",
        "RISK-003"
      ],
      "rationale": "Migration 0129 is the corrected owner for edge tables plus database-enforced same-area and graph invariants after prerequisite migrations."
    },
    {
      "id": "DEC-AUTO-004",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "DATA-001",
        "REQ-003",
        "AC-002",
        "RISK-003"
      ],
      "rationale": "Server validation plus D1 same-area/cycle guards and one contribution revision protect graph integrity and atomic whole-closure movement under races and retries."
    },
    {
      "id": "DEC-AUTO-005",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "DATA-001",
        "AC-002",
        "RISK-006"
      ],
      "rationale": "Unique child identity, common area identity, and explicit root roles provide deterministic one-parent, attribution, and inclusion semantics."
    },
    {
      "id": "DEC-AUTO-006",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-001",
        "UNIT-003",
        "RISK-005"
      ],
      "rationale": "A versioned bounded AST supports BOM formulas without expanding the narrow row parser or executing source text."
    },
    {
      "id": "DEC-AUTO-007",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-002",
        "AC-004",
        "RISK-004"
      ],
      "rationale": "Stable traversal, common-area ownership, and presentation-only rollups ensure each included direct row contributes exactly once to its recursive area subtotal."
    },
    {
      "id": "DEC-AUTO-008",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "OPS-001",
        "REQ-002",
        "REQ-004",
        "RISK-010"
      ],
      "rationale": "Contribution-before-tax ordering keeps Commercial as the sole VAT owner and preserves output parity."
    },
    {
      "id": "DEC-AUTO-009",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-003",
        "AC-005",
        "RISK-007"
      ],
      "rationale": "Both endpoints must be remapped atomically so copied and templated graphs cannot retain source IDs."
    },
    {
      "id": "DEC-AUTO-010",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-003",
        "AC-005",
        "RISK-008"
      ],
      "rationale": "Typed delete, dissolve, same-area reparent, and atomic move-assembly commands reject incident-edge single-row/cross-area moves and prevent silent graph or area-attribution changes."
    },
