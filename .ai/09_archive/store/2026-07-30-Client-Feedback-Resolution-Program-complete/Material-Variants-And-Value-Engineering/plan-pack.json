      ],
      "rationale": "Persisted explicit selection prevents existing rows from changing when a component default changes."
    },
    {
      "id": "DEC-AUTO-003",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-001",
        "AC-002",
        "RISK-003"
      ],
      "rationale": "Separating option-owned material/pricing snapshots from row-owned estimator inputs is required for atomic restoration without data loss; Commercial 0128 alone owns option VAT sidecars, row Remarks, and quotation facts."
    },
    {
      "id": "DEC-AUTO-004",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-003",
        "REQ-004",
        "RISK-005"
      ],
      "rationale": "Distinct persisted concepts remove ambiguity while one resolver preserves a single calculation path."
    },
    {
      "id": "DEC-AUTO-005",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "DATA-001",
        "REQ-003",
        "UNIT-002",
        "UNIT-004"
      ],
      "rationale": "Scoped sidecars and one contribution revision extend flat rows without replacing existing receipts, history, or tree persistence."
    },
    {
      "id": "DEC-AUTO-006",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "DATA-001",
        "REQ-002",
        "AC-001",
        "RISK-004"
      ],
      "rationale": "Only deterministic signature matches are safe to backfill; ambiguity must require explicit repair rather than a default fallback."
    },
    {
      "id": "DEC-AUTO-007",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-004",
        "AC-004",
        "RISK-006"
      ],
      "rationale": "A pure pre-tax resolver plus canonical selected-option identity is the smallest stable extension point for Commercial-owned option VAT snapshots and later additive edges."
    },
    {
      "id": "DEC-AUTO-008",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-003",
        "REQ-005",
        "UNIT-004",
        "RISK-009"
      ],
      "rationale": "One revision-checked batch and monotonic broadcast revision preserve retry, audit, and collaboration integrity."
    },
