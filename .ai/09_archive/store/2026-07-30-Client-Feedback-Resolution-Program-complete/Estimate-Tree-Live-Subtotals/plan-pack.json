  "decisions": [
    {
      "id": "DEC-AUTO-001",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "DATA-001",
        "UNIT-002",
        "UNIT-003",
        "AC-001"
      ],
      "rationale": "A tiny scope-keyed external snapshot bridge solves the sibling boundary without lifting editable rows or coupling Tree to the Content store."
    },
    {
      "id": "DEC-AUTO-002",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-001",
        "PERF-001",
        "UNIT-002",
        "UNIT-004",
        "AC-002",
        "AC-006"
      ],
      "rationale": "The existing recursive initialization and incremental ancestor updates are already the calculation authority; Tree must consume rather than duplicate them."
    },
    {
      "id": "DEC-AUTO-003",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "OPS-001",
        "UNIT-003",
        "UNIT-004",
        "AC-003"
      ],
      "rationale": "Orthogonal data and mutation states preserve partiality while distinguishing optimistic, pending, retained rejection, and rollback behavior."
    },
    {
      "id": "DEC-AUTO-004",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "DATA-002",
        "UNIT-003",
        "UNIT-004",
        "AC-004"
      ],
      "rationale": "Estimate/proposal metadata is the currency authority; server node.total and tree-local PHP fallbacks are stale and potentially wrong."
    },
    {
      "id": "DEC-AUTO-005",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "REQ-001",
        "UNIT-004",
        "AC-002"
      ],
      "rationale": "Every node reads its own recursive store value, making each top-level node the requested main-area rollup without substituting projectTotal."
    },
    {
      "id": "DEC-AUTO-006",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "OPS-001",
        "UNIT-003",
        "UNIT-004",
        "AC-003"
      ],
      "rationale": "Load-limit and lazy-hydration evidence must stay visible so a loaded-data subtotal is never represented as a complete zero or final precision."
    },
    {
      "id": "DEC-AUTO-007",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "UX-001",
        "UNIT-004",
        "AC-004"
      ],
      "rationale": "Accessible names include area, currency, and status while one pane-level transition region prevents a live-region announcement for every keystroke."
    },
    {
      "id": "DEC-AUTO-008",
      "status": "ACTIVE",
      "artifact_path": "00-PLAN.md",
      "affected_ids": [
        "OPS-002",
        "UNIT-003",
        "UNIT-004",
        "AC-005"
      ],
      "rationale": "Final 0127 Variants, 0128 Commercial, and same-area 0129 Assemblies contribution/move semantics must land before tree integration so each payable element is counted once in its owning area and cross-area states fail closed."
    }
