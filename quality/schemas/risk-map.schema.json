{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "prose_extensions",
    "executable_extensions",
    "release_flags",
    "rules"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "prose_extensions": { "type": "array", "items": { "type": "string" } },
    "executable_extensions": { "type": "array", "items": { "type": "string" } },
    "release_flags": { "type": "array", "items": { "type": "string" } },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "profile", "patterns", "reason"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "profile": {
            "enum": [
              "Q0_CONTRACT_ONLY",
              "Q1_CHANGE_GATE",
              "Q2_CRITICAL_CHANGE_GATE",
              "Q3_RELEASE_GATE"
            ]
          },
          "patterns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
