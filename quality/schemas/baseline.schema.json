{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archestimator.local/quality/baseline.schema.json",
  "title": "Canonical admitted quality baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "source",
    "admission",
    "suite",
    "allowed_failures",
    "coverage"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "admitted" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "report",
        "report_sha256",
        "coverage",
        "coverage_sha256",
        "candidate",
        "measurement"
      ],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "report": { "const": "quality/baselines/component/source.vitest.json" },
        "report_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "coverage": { "const": "quality/baselines/component/coverage-summary.json" },
        "coverage_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "candidate": {
          "type": "object",
          "additionalProperties": false,
          "required": ["record", "digest"],
          "properties": {
            "record": { "$ref": "#/$defs/candidateRecord" },
            "digest": { "$ref": "#/$defs/sha256" }
          }
        },
        "measurement": { "$ref": "#/$defs/measurementLineage" }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inventory",
        "inventory_sha256",
        "validation_artifact",
        "validation_sha256",
        "quality_review_artifact",
        "quality_review_sha256",
        "security_review_artifact",
        "security_review_sha256",
        "candidate_digest",
        "author_ids",
        "quality_reviewer",
        "security_reviewer",
        "review_source",
        "reviewer_identity_assurance",
        "author_identity_assurance",
        "bootstrap",
        "predecessor_baseline_sha256"
      ],
      "properties": {
        "inventory": { "const": "quality/baselines/component/inventory.json" },
        "inventory_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "validation_artifact": { "const": "quality/baselines/component/admission.json" },
        "validation_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "quality_review_artifact": {
          "type": "string",
          "const": "quality/reviews/component-baseline-quality.md"
        },
        "quality_review_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "security_review_artifact": {
          "type": "string",
          "const": "quality/reviews/component-baseline-security.md"
        },
        "security_review_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "candidate_digest": { "$ref": "#/$defs/sha256" },
        "author_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" } },
        "quality_reviewer": { "type": "string", "minLength": 1 },
        "security_reviewer": { "type": "string", "minLength": 1 },
        "review_source": { "const": "local-agent" },
        "reviewer_identity_assurance": { "const": "asserted-local" },
        "author_identity_assurance": { "const": "asserted-local" },
        "bootstrap": { "type": "boolean" },
        "predecessor_baseline_sha256": {
          "anyOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          ]
        }
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_files", "total_tests"],
      "properties": {
        "test_files": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "total_tests": { "type": "integer", "minimum": 0 }
      }
    },
    "allowed_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "identity",
          "file",
          "test",
          "kind",
          "signature",
          "classification",
          "owner",
          "rationale",
          "acceptance",
          "expires_at",
          "quality_reviewer",
          "security_reviewer"
        ],
        "properties": {
          "identity": { "type": "string", "minLength": 1 },
          "file": { "type": "string", "minLength": 1 },
          "test": { "type": "string", "minLength": 1 },
          "kind": { "const": "test_failure" },
          "signature": { "type": "string", "minLength": 1 },
          "classification": { "const": "ratchet_noncritical" },
          "owner": { "type": "string", "minLength": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "acceptance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["command", "expected_artifact"],
            "properties": {
              "command": { "type": "string", "minLength": 1 },
              "expected_artifact": { "type": "string", "minLength": 1 }
            }
          },
          "expires_at": { "type": "string", "format": "date-time" },
          "quality_reviewer": { "type": "string", "minLength": 1 },
          "security_reviewer": { "type": "string", "minLength": 1 }
        }
      }
    },
    "coverage": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["statements", "branches", "functions", "lines"],
        "properties": {
          "statements": { "$ref": "#/$defs/coverageValue" },
          "branches": { "$ref": "#/$defs/coverageValue" },
          "branchesTrue": { "$ref": "#/$defs/coverageValue" },
          "functions": { "$ref": "#/$defs/coverageValue" },
          "lines": { "$ref": "#/$defs/coverageValue" }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "comparisonBase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_ref", "resolved_sha"],
      "properties": {
        "input_ref": { "type": "string", "minLength": 1 },
        "resolved_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" }
      }
    },
    "candidateFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "deleted", "sources"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "line_ending_neutral_sha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "deleted": { "type": "boolean" },
        "sources": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["committed", "staged", "unstaged", "untracked"] } }
      }
    },
    "candidateRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "commit_sha", "comparison_base", "profile", "changed_files", "affected_capabilities"],
      "properties": {
        "schema_version": { "const": 1 },
        "commit_sha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "comparison_base": { "$ref": "#/$defs/comparisonBase" },
        "profile": { "enum": ["Q2_CRITICAL_CHANGE_GATE", "Q3_RELEASE_GATE"] },
        "changed_files": { "type": "array", "items": { "$ref": "#/$defs/candidateFile" } },
        "affected_capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "measurementLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integrity_status", "command", "duration_ms", "exit_status", "candidate_digest", "candidate_commit", "comparison_base", "profile", "report_sha256", "coverage_sha256"],
      "properties": {
        "integrity_status": { "const": "PASS" },
        "command": { "const": "bun x vitest run --maxWorkers=1 --coverage --coverage.reportOnFailure=true --reporter=json" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "exit_status": { "type": "integer" },
        "candidate_digest": { "$ref": "#/$defs/sha256" },
        "candidate_commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "comparison_base": { "$ref": "#/$defs/comparisonBase" },
        "profile": { "enum": ["Q2_CRITICAL_CHANGE_GATE", "Q3_RELEASE_GATE"] },
        "report_sha256": { "$ref": "#/$defs/sha256" },
        "coverage_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "coverageValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "covered", "skipped", "pct"],
      "properties": {
        "total": { "type": "number", "minimum": 0 },
        "covered": { "type": "number", "minimum": 0 },
        "skipped": { "type": "number", "minimum": 0 },
        "pct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
