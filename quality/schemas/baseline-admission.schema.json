{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archestimator.local/quality/baseline-admission.schema.json",
  "title": "Deterministic component baseline failure inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "source", "counts", "critical_capabilities", "admission", "identity_derivation", "uncertainties", "records"],
  "properties": {
    "schema_version": { "const": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner", "command", "commit", "artifact", "artifact_sha256", "coverage_artifact", "coverage_sha256", "candidate_artifact", "candidate_sha256"],
      "properties": {
        "runner": { "const": "vitest" },
        "command": { "type": "string", "minLength": 1 },
        "commit": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
        "artifact": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "coverage_artifact": { "type": "string", "minLength": 1 },
        "coverage_sha256": { "$ref": "#/$defs/sha256" },
        "candidate_artifact": { "type": "string", "minLength": 1 },
        "candidate_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["failed_file", "failed_test", "skipped_file", "skipped_test", "collection_failure", "unhandled_error", "infrastructure_failure", "malformed_evidence", "must_fix_critical", "must_fix_infrastructure", "must_fix_noncritical", "ratchet_noncritical", "total_records"],
      "properties": {
        "failed_file": { "$ref": "#/$defs/count" },
        "failed_test": { "$ref": "#/$defs/count" },
        "skipped_file": { "$ref": "#/$defs/count" },
        "skipped_test": { "$ref": "#/$defs/count" },
        "collection_failure": { "$ref": "#/$defs/count" },
        "unhandled_error": { "$ref": "#/$defs/count" },
        "infrastructure_failure": { "$ref": "#/$defs/count" },
        "malformed_evidence": { "$ref": "#/$defs/count" },
        "must_fix_critical": { "$ref": "#/$defs/count" },
        "must_fix_infrastructure": { "$ref": "#/$defs/count" },
        "must_fix_noncritical": { "$ref": "#/$defs/count" },
        "ratchet_noncritical": { "$ref": "#/$defs/count" },
        "total_records": { "$ref": "#/$defs/count" }
      }
    },
    "critical_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "critical"],
        "properties": {
          "id": { "type": "string", "pattern": "^CAP-[A-Z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "critical": { "const": true }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase", "status", "open_must_fix_records", "proposed_ratchet_records", "quality_review", "security_review"],
      "properties": {
        "phase": { "enum": ["draft", "admission"] },
        "status": { "enum": ["draft", "review_pending"] },
        "open_must_fix_records": { "$ref": "#/$defs/count" },
        "proposed_ratchet_records": { "$ref": "#/$defs/count" },
        "quality_review": { "$ref": "#/$defs/reviewPointer" },
        "security_review": { "$ref": "#/$defs/reviewPointer" }
      }
    },
    "identity_derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "algorithm"],
      "properties": {
        "fields": { "const": "runner,file,test_or_scenario,failure_kind,normalized_signature" },
        "algorithm": { "const": "sha256-prefix-20" }
      }
    },
    "uncertainties": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "records": { "type": "array", "items": { "$ref": "#/$defs/record" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "count": { "type": "integer", "minimum": 0 },
    "reviewPointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "artifact"],
      "properties": {
        "status": { "const": "pending" },
        "artifact": { "type": "string", "pattern": "^quality/reviews/.+" }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runner", "file", "test_or_scenario", "failure_kind", "normalized_signature", "critical_capability_ids", "root_cause_cluster", "classification", "owner", "rationale", "acceptance", "status", "evidence_artifact", "expires_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^dom-[a-f0-9]{20}$" },
        "runner": { "const": "vitest" },
        "file": { "type": "string", "minLength": 1 },
        "test_or_scenario": { "type": "string", "minLength": 1 },
        "failure_kind": { "enum": ["failed_file", "failed_test", "skipped_file", "skipped_test", "collection_failure", "unhandled_error", "infrastructure_failure", "malformed_evidence"] },
        "normalized_signature": { "type": "string", "minLength": 1 },
        "critical_capability_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^CAP-[A-Z0-9-]+$" } },
        "root_cause_cluster": { "type": "string", "minLength": 1 },
        "classification": { "enum": ["must_fix_critical", "must_fix_infrastructure", "must_fix_noncritical", "ratchet_noncritical"] },
        "owner": { "type": "string" },
        "rationale": { "type": "string" },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["command", "expected_artifact"],
          "properties": { "command": { "type": "string" }, "expected_artifact": { "type": "string" } }
        },
        "status": { "enum": ["open", "proposed", "closed"] },
        "evidence_artifact": { "type": ["string", "null"] },
        "expires_at": { "type": ["string", "null"], "format": "date-time" }
      }
    }
  }
}
