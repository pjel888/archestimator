NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional local browser/agent inspection only. Never commit real Supabase secrets.
# ARCHESTIMATOR_DEV_AUTH_BYPASS skips the UI login gate in NODE_ENV!=production and localhost only.
# ARCHESTIMATOR_DEV_AUTH_ADMIN_DB is a separate, high-trust local-only escape hatch that makes
# server-side DB calls use the service-role key. Keep it off unless the dev server is bound to loopback
# and you need to inspect local/seeded data without an interactive Supabase login.
ARCHESTIMATOR_DEV_AUTH_BYPASS=0
ARCHESTIMATOR_DEV_AUTH_ADMIN_DB=0
ARCHESTIMATOR_DEV_AUTH_EMAIL=philipjonlewis@gmail.com
SUPABASE_SERVICE_ROLE_KEY=

# App-owned collaboration invite links. Keep disabled unless Supabase Auth email
# provider/templates are verified and the pepper is a real 64-character hex secret.
PROJECT_INVITE_ENTRY_ENABLED=false
ARCHESTIMATOR_INVITE_TOKEN_PEPPER=

# Closed beta access. Keep disabled locally until the allowlist migration and
# route gates are applied. Production closed beta should set this true.
CLOSED_BETA_ACCESS_ENABLED=false

# Closed beta AI posture. AI routes and Ask Flip UI are disabled by default for
# MVP beta. Enable only after a separate AI readiness pass.
ARCHESTIMATOR_AI_ENABLED=false
NEXT_PUBLIC_ASK_FLIP_UI_ENABLED=false

# Optional local CLI/database work only. Never commit a real password.
DATABASE_URL=postgresql://postgres:***@db.<PROJECT-REF>.supabase.co:5432/postgres
