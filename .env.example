NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ARCHESTIMATOR_ALLOWED_APP_ORIGINS=http://localhost:3000

# Cloudflare Better Auth D1 runtime. Keep the secret blank in examples; set a
# 32+ character Worker secret only for local preview or production proof.
ARCHESTIMATOR_AUTH_PROVIDER=better-auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Google OAuth local dev must have these redirect URIs on the Google web client:
# http://localhost:3000/api/auth/callback/google
# http://127.0.0.1:3000/api/auth/callback/google
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# Required dedicated HMAC secret for the short-lived protected-route Terms gate
# cookie (32+ chars). No fallback to BETTER_AUTH_SECRET or publication secrets.
ARCHESTIMATOR_TERMS_GATE_SECRET=

# Optional local browser/agent inspection only. Never commit real secrets.
# ARCHESTIMATOR_DEV_AUTH_BYPASS skips the UI login gate in NODE_ENV!=production, localhost only,
# and only when ARCHESTIMATOR_DEV_AUTH_BYPASS_SECRET is provided in the
# x-archestimator-dev-auth-bypass header or archestimator-dev-auth-bypass cookie.
ARCHESTIMATOR_DEV_AUTH_BYPASS=0
ARCHESTIMATOR_DEV_AUTH_ADMIN_DB=0
ARCHESTIMATOR_DEV_AUTH_EMAIL=philipjonlewis@gmail.com
# Use a unique 32+ character local secret; leave blank to disable bypass even when flags are on.
ARCHESTIMATOR_DEV_AUTH_BYPASS_SECRET=

# Opt-in: bind bun dev to production D1 + R2 via wrangler.next-dev.remote.jsonc.
# Exact value "1" only (deliberate fail-closed). Requires working Wrangler remote
# bindings (Cloudflare Access: interactive `cloudflared access login`, or
# CLOUDFLARE_ACCESS_CLIENT_ID + CLOUDFLARE_ACCESS_CLIENT_SECRET). Without Access
# auth, remote D1 queries hang — prefer `bun run cf:d1-sync-from-remote` for
# localhost workshop parity. EMAIL/Queue stay local. Keep this in .env.local only.
ARCH_DEV_USE_REMOTE_BINDINGS=0

# App-owned collaboration invite links. Keep disabled until the invitation
# acceptance route has hosted D1 proof.
PROJECT_INVITE_ENTRY_ENABLED=false
ARCHESTIMATOR_INVITE_TOKEN_PEPPER=
# Optional separate server-only HMAC key for invite rate-limit IP hashing.
# Falls back to ARCHESTIMATOR_INVITE_TOKEN_PEPPER.
ARCHESTIMATOR_INVITE_RATE_LIMIT_HASH_PEPPER=

# Required for collaboration-room protocol v2. Do not reuse invite or identity keys.
REALTIME_ROOM_TOKEN_SECRET=
# Required in production for Ed25519 realtime identity envelopes. Do not reuse invite material.
REALTIME_IDENTITY_SIGNING_KEY=
# Required by the trusted revoke-subject control path for collaboration rooms.
COLLABORATION_ROOM_CONTROL_SECRET=

# Platform admin dashboard. Comma-separated allowlist. Required in production
# (email allowlist fails closed when unset). Dev/test default to the solo
# operator email when unset. ADMIN_DASHBOARD_ENABLED overrides the D1
# feature_flags.admin_dashboard_enabled row when set.
PLATFORM_ADMIN_EMAILS=philipjonlewis@gmail.com
# Master switch for /admin. Set 0/false/off to kill the surface (redirects to
# /workshop). Platform-admin identity is still required separately.
ADMIN_DASHBOARD_ENABLED=true

# Closed beta access. Keep disabled locally until the allowlist migration and
# route gates are applied. Hosted Cloudflare Workers fail closed when this is
# unset; production closed beta should set this true (Worker secret).
# Escape hatch only: ARCHESTIMATOR_ALLOW_OPEN_BETA=1
CLOSED_BETA_ACCESS_ENABLED=false

# Public share / publication secrets. Required in production if share links are
# visible. Use long random Worker secrets; never commit real values.
PUBLICATION_TOKEN_ENCRYPTION_SECRET=
PUBLICATION_TOKEN_HASH_SECRET=
PUBLICATION_ACCESS_COOKIE_SECRET=

# Email delivery fails closed unless explicitly enabled. Use Cloudflare Email
# Service for auth magic links, publication emails, and collaboration invites.
ARCHESTIMATOR_EMAIL_DELIVERY_ENABLED=false
ARCHESTIMATOR_EMAIL_PROVIDER=cloudflare-email
CLOUDFLARE_EMAIL_FROM=
CLOUDFLARE_EMAIL_REPLY_TO=support@archestimator.com

# Support mailbox (one-to-one admin inbox). Inbound stays fail-closed until enabled.
# Do not put secrets here — addresses and feature gates only.
ARCHESTIMATOR_INBOUND_EMAIL_ENABLED=false
ARCHESTIMATOR_SUPPORT_MAILBOX=support@archestimator.com
ARCHESTIMATOR_INBOUND_EMAIL_ALIASES=support@archestimator.com
ARCHESTIMATOR_SUPPORT_EMAIL_FROM=support@archestimator.com
ARCHESTIMATOR_SUPPORT_EMAIL_FROM_NAME=Archestimator Support
ARCHESTIMATOR_SUPPORT_FORWARD_ENABLED=false
ARCHESTIMATOR_SUPPORT_FORWARD_TO=
# ARCHESTIMATOR_SUPPORT_MAX_MESSAGE_BYTES=1500000
# ARCHESTIMATOR_SUPPORT_MAX_ATTACHMENT_BYTES=5000000
# ARCHESTIMATOR_SUPPORT_MAX_ATTACHMENTS=10

# Closed beta AI posture. AI routes and Ask Flip UI are disabled by default for
# MVP beta. Enable only after a separate AI readiness pass.
ARCHESTIMATOR_AI_ENABLED=false
NEXT_PUBLIC_ASK_FLIP_UI_ENABLED=false
DEEPSEEK_API_KEY=

# Default-on client performance paths. Set an individual flag to false/0/no/off
# only when temporarily disabling a virtualized surface during troubleshooting.
NEXT_PUBLIC_TREE_VIRTUALIZATION=true
NEXT_PUBLIC_EMC_VIRTUALIZATION=true
NEXT_PUBLIC_ESTIMATE_ROW_VIRTUALIZATION=true
NEXT_PUBLIC_ESTIMATE_COLUMN_RESIZE_ENABLED=false

# Optional browser-restricted Google Maps configuration for project location UI.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Public analytics are optional during closed beta and must match the privacy
# notice before being configured.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
NEXT_PUBLIC_BETA_TELEMETRY_ENABLED=false

# Cloudflare Cron Trigger proof wrapper. Keep jobs disabled unless the target
# provider route has provider proof and rollback notes.
CRON_SECRET=
UPLOAD_CLEANUP_JOB_SECRET=
UPLOAD_SCAN_JOB_SECRET=
UPLOAD_JOBS_ENABLED=0
CLOUDFLARE_UPLOAD_JOBS_DRY_RUN=1
CLOUDFLARE_UPLOAD_JOBS_ORIGIN=https://archestimator.internal

# Upload object storage provider. Cloudflare R2 is the required Worker upload
# storage path; retired legacy provider values are rejected at runtime.
ARCHESTIMATOR_UPLOAD_STORAGE_PROVIDER=cloudflare-r2
# Hosted upload runtime proof budgets for the Cloudflare Worker dry-run route.
ARCH_UPLOAD_HOSTED_MEMORY_MB=128
ARCH_UPLOAD_HOSTED_BODY_LIMIT_BYTES=4194304
ARCH_UPLOAD_HOSTED_ROUTE_DURATION_MS=30000
ARCH_UPLOAD_HOSTED_CONCURRENT_UPLOADS=3
ARCH_UPLOAD_STORAGE_LATENCY_P95_MS=250
# Upload image processing provider. Keep node-sharp for current Node deploys;
# select cloudflare-images only when the Cloudflare Images binding is ready to prove.
ARCHESTIMATOR_IMAGE_PROCESSING_PROVIDER=node-sharp

# Release verification toggles. Keep off unless running the corresponding
# staging/integration smoke suites with safe credentials.
ARCHESTIMATOR_E2E_ROUTE_ERROR_SMOKE=0

# Optional local SQLite/D1 proof work only. Never commit a production database URL.
DATABASE_URL=
