{
  "name": "archestimator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:design-system": "node scripts/enforce-app-design-system.mjs",
    "lint:font-size": "bun run lint:design-system",
    "type-check": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:dom": "vitest run --maxWorkers=1",
    "test:dom:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:perf": "playwright test e2e/route-transition-performance.spec.ts",
    "launch:verify-hosted-export": "bun run scripts/verify-hosted-export-route.ts",
    "launch:supabase-readiness": "supabase db query --linked --file scripts/sql/linked-supabase-launch-readiness.sql --output json",
    "perf:measure-routes": "bun run scripts/measure-route-transitions.ts",
    "perf:seed-fixture": "bun run scripts/seed-performance-test-data.ts",
    "perf:profile-peak-load": "vitest run tests/vitest/route-transition-peak-load-profile.test.tsx --maxWorkers=1",
    "validate": "bun run type-check && bun run lint && bun run lint:design-system && bun run test && bun run test:dom"
  },
  "dependencies": {
    "@firecms/neat": "0.8.0",
    "@next/third-parties": "^16.2.6",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.106.2",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "exceljs": "^4.4.0",
    "lenis": "^1.3.23",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-complex-tree": "^2.6.1",
    "react-dom": "19.2.6",
    "resend": "^6.12.4",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.2.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/d3": "^7.4.3",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "patchedDependencies": {
    "@firecms/neat@0.8.0": "patches/@firecms%2Fneat@0.8.0.patch"
  }
}
