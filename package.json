    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-context-menu": "^2.3.4",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@tanstack/react-query": "5.100.14",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.7",
    "@tiptap/extension-file-handler": "^3.28.0",
    "@tiptap/extension-image": "^3.28.0",
    "@tiptap/extension-link": "^3.28.0",
    "@tiptap/extension-placeholder": "^3.28.0",
    "@tiptap/extension-underline": "^3.28.0",
    "@tiptap/pm": "^3.28.0",
    "@tiptap/react": "^3.28.0",
    "@tiptap/starter-kit": "^3.28.0",
    "better-auth": "1.6.23",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "exceljs": "^4.4.0",
    "gsap": "^3.15.0",
    "next": "16.2.10",
