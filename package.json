  "scripts": {
    "predev": "node scripts/check-node-version.mjs && bun run dev:check-d1-migrations",
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=2048\" next dev --turbopack",
    "predev:turbo": "node scripts/check-node-version.mjs && bun run dev:check-d1-migrations",
