{
  "name": "archestimator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "predev": "node scripts/check-node-version.mjs",
    "dev": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=2048\" next dev --turbopack",
    "predev:turbo": "node scripts/check-node-version.mjs",
    "dev:turbo": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=2048\" next dev --turbopack",
    "build": "next build",
    "cf:build": "ARCHESTIMATOR_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
    "cf:preview": "ARCHESTIMATOR_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "ARCHESTIMATOR_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build && OPEN_NEXT_DEPLOY=true CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false NODE_OPTIONS='--import ./scripts/wrangler-undici-timeout.mjs' wrangler deploy --keep-vars --minify --no-upload-source-maps",
    "cf:upload-version": "OPEN_NEXT_DEPLOY=true CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false NODE_OPTIONS='--import ./scripts/wrangler-undici-timeout.mjs' opennextjs-cloudflare upload",
    "cf:build-upload-version": "bun run cf:build && bun run cf:upload-version",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:verify-preview-routes": "bun run scripts/verify-cloudflare-worker-preview-routes.ts",
    "cf:verify-hosted-routes": "bun run scripts/verify-cloudflare-hosted-routes.ts",
    "cf:verify-hosted-performance": "bun run scripts/verify-cloudflare-hosted-performance.ts",
    "cf:check-readiness": "bun run scripts/check-cloudflare-worker-readiness.ts",
    "cf:check-toolchain": "bun run scripts/check-cloudflare-platform-toolchain.ts",
    "cf:check-wrangler-auth": "bun run scripts/check-cloudflare-wrangler-auth.ts",
    "cf:sync-worker-secrets": "bun run scripts/sync-cloudflare-worker-secrets.ts",
    "cf:check-provider-resources": "bun run scripts/check-cloudflare-provider-resources.ts",
    "cf:check-latest-deploy-source-smoke": "bun run scripts/check-cloudflare-latest-deploy-source-smoke.ts",
    "cf:latest-deploy-source-smoke-template": "WRITE_DEPLOY_SOURCE_SMOKE_TEMPLATE=1 bun run scripts/check-cloudflare-latest-deploy-source-smoke.ts",
    "cf:provider-exit-pack": "bun run scripts/generate-cloudflare-provider-exit-pack.ts",
    "cf:provider-exit-operator-template": "WRITE_OPERATOR_RECORD_TEMPLATE=1 bun run scripts/generate-cloudflare-provider-exit-pack.ts",
    "cf:provider-proof": "bun run scripts/verify-cloudflare-provider-proof.ts",
    "cf:jobs-proof": "bun run scripts/verify-cloudflare-jobs-proof.ts",
    "cf:inventory": "bun run scripts/generate-cloudflare-migration-inventory.ts",
    "cf:pricing": "bun run scripts/generate-cloudflare-pricing-snapshot.ts",
    "cf:check-deploy-dry-run": "bun run scripts/check-cloudflare-wrangler-deploy-dry-run.ts",
    "cf:workbook": "bun run scripts/generate-cloudflare-cost-performance-workbook.ts",
    "cf:d1-authz-matrix": "bun run scripts/generate-cloudflare-d1-authz-access-matrix.ts",
    "cf:d1-rpc-map": "bun run scripts/generate-cloudflare-d1-rpc-rewrite-map.ts",
    "cf:d1-rpc-proof": "bun run scripts/generate-cloudflare-d1-rpc-transaction-proof.ts",
    "cf:d1-beta-feedback-proof": "bun run scripts/generate-cloudflare-d1-beta-feedback-proof.ts",
    "cf:d1-collaboration-invitation-proof": "bun run scripts/generate-cloudflare-d1-collaboration-invitation-proof.ts",
    "cf:d1-closed-beta-proof": "bun run scripts/generate-cloudflare-d1-closed-beta-proof.ts",
    "cf:d1-component-library-proof": "bun run scripts/generate-cloudflare-d1-component-library-proof.ts",
    "cf:d1-estimate-history-proof": "bun run scripts/generate-cloudflare-d1-estimate-history-proof.ts",
    "cf:verify-hosted-estimate-history": "bun run scripts/verify-cloudflare-hosted-estimate-history-proof.ts",
    "cf:verify-hosted-collaboration-invitation": "bun run scripts/verify-cloudflare-hosted-collaboration-invitation-proof.ts",
    "cf:verify-hosted-upload-runtime": "bun run scripts/verify-hosted-upload-runtime.ts",
    "cf:verify-hosted-upload-operations": "bun run scripts/verify-hosted-upload-operations.ts",
    "cf:verify-hosted-upload-lifecycle": "bun run scripts/verify-cloudflare-hosted-upload-lifecycle-proof.ts",
    "cf:verify-hosted-upload-ui": "bun run scripts/verify-cloudflare-hosted-upload-ui-proof.ts",
    "cf:verify-hosted-collaboration-ui": "bun run scripts/verify-cloudflare-hosted-collaboration-ui-proof.ts",
    "cf:d1-restore-rehearsal": "bun run scripts/generate-cloudflare-d1-restore-rehearsal.ts",
    "cf:d1-sync-from-remote": "bun run scripts/sync-local-d1-from-remote.ts",
    "cf:d1-runtime-proof": "bun run scripts/verify-cloudflare-d1-runtime-performance-proof.ts",
    "cf:d1-performance-proof": "bun run scripts/generate-cloudflare-d1-performance-proof.ts",
    "cf:better-auth-provider-proof": "bun run scripts/verify-cloudflare-better-auth-provider-proof.ts",
    "cf:better-auth-proof": "bun run scripts/generate-cloudflare-better-auth-proof.ts",
    "cf:check-d1-auth-realtime": "bun run scripts/check-cloudflare-d1-auth-realtime-readiness.ts",
    "cf:queues-cron-proof": "bun run scripts/generate-cloudflare-queues-cron-proof.ts",
    "cf:release-gates": "bun run scripts/check-cloudflare-release-gates.ts",
    "cf:check-provider": "bun run scripts/check-cloudflare-provider-readiness.ts",
    "cf:check-dns-delegation": "bun run scripts/check-cloudflare-dns-delegation.ts",
    "cf:check-email": "bun run scripts/check-cloudflare-email-readiness.ts",
    "cf:check-support-email-inbound": "bun run scripts/check-cloudflare-support-email-inbound-readiness.ts",
    "graph:reindex": "node scripts/run-safe-gitnexus-command.mjs analyze --neutralize-after",
    "graph:gitnexus": "node scripts/run-safe-gitnexus-command.mjs",
    "graph:neutralize": "node scripts/neutralize-graph-mandate.mjs",
    "validate:agents": "node scripts/validate-ai-workflow-adapters.mjs",
    "validate:agents:full": "node scripts/validate-ai-workflow-adapters.mjs --resolver=all",
    "skills:update": "DISABLE_TELEMETRY=1 npx -y skills@1.5.16 update --global --yes && omx update --stable && codex plugin marketplace upgrade --json && node scripts/update-kimi-webbridge.mjs && node scripts/consolidate-skill-catalog.mjs && node scripts/validate-skill-catalog.mjs",
    "skills:consolidate": "node scripts/consolidate-skill-catalog.mjs",
    "validate:skills": "node scripts/validate-skill-catalog.mjs",
    "validate:plan-pack": "node scripts/validate-plan-pack.mjs",
    "validate:workflow-simulations": "node scripts/validate-agent-workflow-simulations.mjs",
    "validate:planning-prompts": "node scripts/validate-planning-prompt-suite.mjs && node scripts/validate-agent-workflow-simulations.mjs",
    "supermemory:configure": "node scripts/configure-supermemory-server.mjs --install-launch-agent",
    "supermemory:ensure": "node scripts/ensure-supermemory-server.mjs",
    "supermemory:start": "node scripts/start-verified-supermemory-server.mjs",
    "supermemory:search": "node scripts/supermemory-memory.mjs search",
    "supermemory:add": "node scripts/supermemory-memory.mjs add",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "storybook:check-boundary": "node scripts/check-storybook-boundary.mjs",
    "storybook:check-components": "node scripts/check-storybook-component-coverage.mjs",
    "storybook:validate": "bun run storybook:check-components && bun run storybook:check-boundary && STORYBOOK_DISABLE_TELEMETRY=1 bun run build-storybook -- --output-dir /tmp/archestimator-storybook-static-standalone",
    "start": "next start",
    "logs:tail": "bun run scripts/tail-dev-logs.mjs",
    "logs:explain": "bun run scripts/tail-dev-logs.mjs --explain",
    "logs:debug": "bun run scripts/tail-dev-logs.mjs --explain-latest-error",
    "logs:dev": "bun run dev",
    "logs:emit-test": "bun run scripts/emit-test-log.mjs",
    "ops:incident": "bun run scripts/record-operational-incident.ts",
    "ops:check-incidents": "bun run scripts/check-operational-incidents.ts",
    "ops:check-dev-auth-bypass": "bun run scripts/check-dev-auth-bypass.ts",
    "ops:check-observability": "bun run scripts/check-production-observability-proof.ts",
    "ops:check-observability-env": "bun run scripts/check-observability-proof-env.ts",
    "ops:check-observability-route": "bun run scripts/check-observability-proof-route.ts",
    "ops:observability-drill": "bun run scripts/run-observability-proof-drill.ts",
    "ops:check-alert-scenarios": "bun run scripts/check-alert-scenario-readiness.ts",
    "ops:agent-debug-snapshot": "bun run scripts/check-agent-debugging-snapshot.ts",
    "ops:debug-ledger": "bun run scripts/record-debugging-session.ts",
    "ops:check-error-handling": "bun run scripts/check-error-handling-contract.ts",
    "validate:error-handling": "bun run scripts/check-error-handling-contract.ts --no-write",
    "ops:collect-workers-logs-proof": "bun run scripts/collect-workers-logs-proof.ts",
    "ops:verify-observability-alert": "bun run scripts/verify-observability-alert-delivery.ts",
    "launch:check-observability": "bun run scripts/check-production-observability-proof.ts",
    "launch:check-alert-scenarios": "bun run scripts/check-alert-scenario-readiness.ts",
    "lint": "eslint",
    "lint:design-system": "node scripts/enforce-app-design-system.mjs",
    "lint:font-size": "bun run lint:design-system",
    "pretype-check": "node scripts/check-node-version.mjs",
    "type-check": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=4096\" tsc --noEmit",
    "test": "bun test tests/unit",
    "test:dom": "vitest run --maxWorkers=1",
    "test:dom:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:perf": "playwright test e2e/route-transition-performance.spec.ts",
    "generate:project-charts-payload-evidence": "bun run scripts/generate-project-charts-payload-evidence.ts",
    "launch:verify-hosted-auth": "bun run scripts/verify-hosted-auth-routes.ts",
    "launch:verify-hosted-export": "bun run scripts/verify-hosted-export-route.ts",
    "launch:check-support-dns": "bun run scripts/check-support-email-dns.ts",
    "launch:check-support-monitoring": "bun run scripts/check-support-monitoring-readiness.ts",
    "launch:check-legal-owner": "bun run scripts/check-legal-owner-readiness.ts",
    "launch:check-limited-cohort-legal": "bun run scripts/check-limited-cohort-legal-readiness.ts",
    "dbidx:audit-repo": "bun run scripts/audit-dbidx-repo.ts",
    "perf:measure-routes": "bun run scripts/measure-route-transitions.ts",
    "perf:check-routes": "bun run scripts/check-route-transition-readiness.ts",
    "perf:dashboard-query-count": "bun run scripts/measure-workshop-dashboard-query-count.ts",
    "perf:seed-fixture": "bun run scripts/seed-performance-test-data.ts",
    "perf:library-baseline": "bun run scripts/measure-library-performance-baseline.ts",
    "perf:profile-peak-load": "vitest run tests/vitest/route-transition-peak-load-profile.test.tsx --maxWorkers=1",
    "perf:collect-live-evidence": "bun run scripts/collect-live-db-performance-evidence.ts",
    "validate": "bun run type-check && bun run lint && bun run validate:error-handling && bun run lint:design-system && bun run lint:design && bun run validate:planning-prompts && bun run test && bun run test:dom",
    "lint:design": "node .agents/skills/impeccable/scripts/detect.mjs --strict src/components/admin src/components/sidebar src/components/workshop",
    "launch:verify-hosted-sensitive-routes": "bun run scripts/verify-hosted-sensitive-route-fail-closed.ts",
    "doctor": "./node_modules/.bin/react-doctor"
  },
