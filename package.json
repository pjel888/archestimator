    "lint:design-system": "node scripts/enforce-app-design-system.mjs",
    "lint:font-size": "bun run lint:design-system",
    "pretype-check": "node scripts/check-node-version.mjs",
    "type-check": "NODE_OPTIONS=\"${NODE_OPTIONS:+$NODE_OPTIONS }--max-old-space-size=4096\" tsc --noEmit",
    "test": "bun test tests/unit",
    "test:unit": "bun test tests/unit",
    "test:unit:coverage": "bun scripts/quality/run-evidence-command.ts --artifact artifacts/quality/unit.json --evidence-id test:unit:coverage -- bun test tests/unit --coverage --coverage-reporter=text --coverage-reporter=lcov --coverage-dir=artifacts/coverage/unit",
    "test:dom": "vitest run --maxWorkers=1",
    "test:component": "vitest run --maxWorkers=1",
    "test:component:change": "bun scripts/quality/component.ts --profile Q1_CHANGE_GATE",
    "test:component:critical": "bun scripts/quality/component.ts --profile Q2_CRITICAL_CHANGE_GATE",
    "test:component:release": "bun scripts/quality/component.ts --profile Q3_RELEASE_GATE",
    "test:component:coverage": "bun run test:component:critical",
    "test:workers": "vitest run --config tests/vitest/capabilities/workers.vitest.config.mts",
    "test:workers:coverage": "bun scripts/quality/run-evidence-command.ts --artifact artifacts/quality/workers.json --evidence-id test:workers:coverage -- vitest run --config tests/vitest/capabilities/workers.vitest.config.mts --coverage",
    "test:contracts": "vitest run tests/vitest/quality --maxWorkers=1",
    "test:property": "bun scripts/quality/run-evidence-command.ts --artifact artifacts/quality/property.json --evidence-id test:property -- vitest run --config tests/vitest/capabilities/property.vitest.config.ts",
    "test:bdd": "bun scripts/quality/run-evidence-command.ts --artifact artifacts/quality/bdd.json --evidence-id test:bdd -- cucumber-js --config cucumber.mjs",
    "test:bdd:smoke": "bun scripts/quality/run-evidence-command.ts --artifact artifacts/quality/bdd-smoke.json --evidence-id test:bdd:smoke -- cucumber-js --config cucumber.mjs --tags '@smoke'",
    "test:a11y": "bun scripts/quality/run-evidence-command.ts --artifact artifacts/quality/a11y.json --evidence-id test:a11y -- vitest run --config vitest.storybook.config.ts",
    "test:dom:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "bun scripts/quality/run-evidence-command.ts --artifact artifacts/quality/e2e-smoke.json --evidence-id test:e2e:smoke -- playwright test e2e/quality --project=chromium",
    "test:e2e:matrix": "bun scripts/quality/run-evidence-command.ts --artifact artifacts/quality/e2e-matrix.json --evidence-id test:e2e:matrix -- env ARCHESTIMATOR_E2E_LIBRARY_BROWSER_MATRIX=1 playwright test e2e/quality",
