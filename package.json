    "cf:build": "ARCHESTIMATOR_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build",
    "cf:preview": "ARCHESTIMATOR_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "bun run cf:check-cache-purge && bun run cf:check-d1-migrations && ARCHESTIMATOR_CLOUDFLARE_BUILD=1 opennextjs-cloudflare build && OPEN_NEXT_DEPLOY=true CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false NODE_OPTIONS='--import ./scripts/wrangler-undici-timeout.mjs' wrangler deploy --keep-vars --minify --no-upload-source-maps && bun run cf:purge-cache",
    "cf:check-cache-purge": "bun run scripts/purge-cloudflare-cache.ts --check",
    "cf:check-d1-migrations": "bun run scripts/check-cloudflare-d1-migrations.ts",
    "cf:purge-cache": "bun run scripts/purge-cloudflare-cache.ts",
    "cf:upload-version": "bun run cf:check-d1-migrations && OPEN_NEXT_DEPLOY=true CLOUDFLARE_LOAD_DEV_VARS_FROM_DOT_ENV=false NODE_OPTIONS='--import ./scripts/wrangler-undici-timeout.mjs' opennextjs-cloudflare upload",
    "cf:build-upload-version": "bun run cf:check-d1-migrations && bun run cf:build && bun run cf:upload-version",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "cf:verify-preview-routes": "bun run scripts/verify-cloudflare-worker-preview-routes.ts",
    "cf:verify-hosted-routes": "bun run scripts/verify-cloudflare-hosted-routes.ts",
    "cf:verify-hosted-performance": "bun run scripts/verify-cloudflare-hosted-performance.ts",
    "cf:check-readiness": "bun run scripts/check-cloudflare-worker-readiness.ts",
    "cf:check-toolchain": "bun run scripts/check-cloudflare-platform-toolchain.ts",
    "cf:check-wrangler-auth": "bun run scripts/check-cloudflare-wrangler-auth.ts",
    "cf:sync-worker-secrets": "bun run scripts/sync-cloudflare-worker-secrets.ts",
    "cf:check-provider-resources": "bun run scripts/check-cloudflare-provider-resources.ts",
    "cf:check-latest-deploy-source-smoke": "bun run scripts/check-cloudflare-latest-deploy-source-smoke.ts",
    "cf:latest-deploy-source-smoke-template": "WRITE_DEPLOY_SOURCE_SMOKE_TEMPLATE=1 bun run scripts/check-cloudflare-latest-deploy-source-smoke.ts",
    "cf:provider-exit-pack": "bun run scripts/generate-cloudflare-provider-exit-pack.ts",
    "cf:provider-exit-operator-template": "WRITE_OPERATOR_RECORD_TEMPLATE=1 bun run scripts/generate-cloudflare-provider-exit-pack.ts",
    "cf:provider-proof": "bun run scripts/verify-cloudflare-provider-proof.ts",
    "cf:jobs-proof": "bun run scripts/verify-cloudflare-jobs-proof.ts",
    "cf:inventory": "bun run scripts/generate-cloudflare-migration-inventory.ts",
    "cf:pricing": "bun run scripts/generate-cloudflare-pricing-snapshot.ts",
    "cf:check-deploy-dry-run": "bun run scripts/check-cloudflare-wrangler-deploy-dry-run.ts",
    "cf:workbook": "bun run scripts/generate-cloudflare-cost-performance-workbook.ts",
    "cf:d1-authz-matrix": "bun run scripts/generate-cloudflare-d1-authz-access-matrix.ts",
    "cf:d1-rpc-map": "bun run scripts/generate-cloudflare-d1-rpc-rewrite-map.ts",
    "cf:d1-rpc-proof": "bun run scripts/generate-cloudflare-d1-rpc-transaction-proof.ts",
    "cf:d1-beta-feedback-proof": "bun run scripts/generate-cloudflare-d1-beta-feedback-proof.ts",
    "cf:d1-collaboration-invitation-proof": "bun run scripts/generate-cloudflare-d1-collaboration-invitation-proof.ts",
