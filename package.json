{
  "name": "archestimator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:font-size": "node scripts/enforce-app-font-size.mjs",
    "type-check": "tsc --noEmit",
    "test": "bun test tests/unit",
