    "quality:operations": "bun scripts/quality/operations.ts",
    "quality:inventory": "bun scripts/quality/inventory.ts",
    "quality:enforcement-contract": "bun scripts/quality/enforcement-contract.ts",
    "quality:manifest": "bun scripts/quality/build-manifest.ts",
    "quality:report": "bun scripts/quality/report.ts",
    "quality:review-manifest": "bun scripts/quality/report.ts --require-command-log",
    "quality:verify": "bun scripts/quality/verify.ts",
    "quality:fast": "bun run quality:contracts && bun run quality:classify && bun run test:unit",
    "quality:pr": "bun run quality:classify -- --profile Q1_CHANGE_GATE && bun run quality:verify",
    "quality:critical": "bun run quality:classify -- --profile Q2_CRITICAL_CHANGE_GATE && bun run quality:verify",
    "quality:release": "bun run quality:classify -- --release && bun run quality:verify",
    "skills:update": "DISABLE_TELEMETRY=1 npx -y skills@1.5.16 update --global --yes && omx update --stable && codex plugin marketplace upgrade --json && node scripts/update-kimi-webbridge.mjs && node scripts/consolidate-skill-catalog.mjs && node scripts/validate-skill-catalog.mjs",
    "skills:consolidate": "node scripts/consolidate-skill-catalog.mjs",
    "validate:skills": "node scripts/validate-skill-catalog.mjs",
    "validate:plan-pack": "node scripts/validate-plan-pack.mjs",
    "validate:workflow-simulations": "node scripts/validate-agent-workflow-simulations.mjs",
    "validate:planning-prompts": "node scripts/validate-planning-prompt-suite.mjs && node scripts/validate-agent-workflow-simulations.mjs",
