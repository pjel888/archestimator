    "ops:collect-workers-logs-proof": "bun run scripts/collect-workers-logs-proof.ts",
    "ops:verify-observability-alert": "bun run scripts/verify-observability-alert-delivery.ts",
    "launch:check-observability": "bun run scripts/check-production-observability-proof.ts",
    "launch:check-alert-scenarios": "bun run scripts/check-alert-scenario-readiness.ts",
