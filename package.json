    "test:mutation:full": "bun scripts/quality/run-mutation.ts --scope full",
    "test:mutation:representative": "bun scripts/quality/run-mutation.ts --scope representative",
    "test:ai-evals": "bun scripts/quality/run-evidence-command.ts --artifact artifacts/quality/ai-eval.json --evidence-id test:ai-evals -- vitest run tests/vitest/ai-evals/deterministic-ai-eval.test.ts --maxWorkers=1",
    "test:e2e:perf": "playwright test e2e/route-transition-performance.spec.ts",
