{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'hook=\"$(npm root -g 2>/dev/null)/oh-my-codex/dist/scripts/codex-native-hook.js\"; [ -f \"$hook\" ] && node \"$hook\" || true'",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'hook=\"$(npm root -g 2>/dev/null)/oh-my-codex/dist/scripts/codex-native-hook.js\"; [ -f \"$hook\" ] && node \"$hook\" || true'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'hook=\"$(npm root -g 2>/dev/null)/oh-my-codex/dist/scripts/codex-native-hook.js\"; [ -f \"$hook\" ] && node \"$hook\" || true'",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'hook=\"$(npm root -g 2>/dev/null)/oh-my-codex/dist/scripts/codex-native-hook.js\"; [ -f \"$hook\" ] && node \"$hook\" || true'",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'hook=\"$(npm root -g 2>/dev/null)/oh-my-codex/dist/scripts/codex-native-hook.js\"; [ -f \"$hook\" ] && node \"$hook\" || true'",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'hook=\"$(npm root -g 2>/dev/null)/oh-my-codex/dist/scripts/codex-native-hook.js\"; [ -f \"$hook\" ] && node \"$hook\" || true'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh -lc 'hook=\"$(npm root -g 2>/dev/null)/oh-my-codex/dist/scripts/codex-native-hook.js\"; [ -f \"$hook\" ] && node \"$hook\" || true'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
