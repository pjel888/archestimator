# Copy to .dev.vars for local Cloudflare preview proof only.
# Never commit real secret values.
CRON_SECRET=
UPLOAD_CLEANUP_JOB_SECRET=
UPLOAD_SCAN_JOB_SECRET=
UPLOAD_JOBS_ENABLED=0
CLOUDFLARE_UPLOAD_JOBS_DRY_RUN=1
CLOUDFLARE_UPLOAD_JOBS_ORIGIN=https://archestimator.internal

# Platform admin dashboard allowlist + kill-switch for local Worker preview.
PLATFORM_ADMIN_EMAILS=philipjonlewis@gmail.com
ADMIN_DASHBOARD_ENABLED=0

# Better Auth D1 preview runtime. Never commit a real secret value.
ARCHESTIMATOR_AUTH_PROVIDER=better-auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
# Google OAuth local preview must have these redirect URIs on the Google web client:
# http://localhost:3000/api/auth/callback/google
# http://127.0.0.1:3000/api/auth/callback/google
# http://localhost:8787/api/auth/callback/google
# http://127.0.0.1:8787/api/auth/callback/google
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
# Optional dedicated HMAC secret for the short-lived protected-route Terms gate
# cookie. Falls back to BETTER_AUTH_SECRET, then PUBLICATION_ACCESS_COOKIE_SECRET.
ARCHESTIMATOR_TERMS_GATE_SECRET=

# Collaboration-room protocol v2 requires separate Worker secrets.
# Do not reuse invite or identity signing material.
REALTIME_ROOM_TOKEN_SECRET=
REALTIME_IDENTITY_SIGNING_KEY=
COLLABORATION_ROOM_CONTROL_SECRET=

# Cloudflare Email Service preview placeholders. EMAIL is a Wrangler binding;
# these values control sender selection only.
ARCHESTIMATOR_EMAIL_DELIVERY_ENABLED=false
ARCHESTIMATOR_EMAIL_PROVIDER=cloudflare-email
CLOUDFLARE_EMAIL_FROM=
CLOUDFLARE_EMAIL_REPLY_TO=support@archestimator.com

# Local preview-only placeholders. Use real Worker secrets for deployed proof.
PUBLICATION_TOKEN_ENCRYPTION_SECRET=
PUBLICATION_TOKEN_HASH_SECRET=
PUBLICATION_ACCESS_COOKIE_SECRET=

# P0.6 (Security & Compliance Program): HMAC-SHA-256 pepper for account audit
# ip_hash / user_agent_hash. Required in production; falls back to a non-secret
# dev value when NODE_ENV is not production. Set via `wrangler secret put` for
# deployed Workers. Treat legacy plain `sha256:` rows as pseudonymous personal
# data — see .ai/03_plans/000-Follow Ups/2026-07-04-Security-Compliance-Followups.md
AUTH_AUDIT_HASH_PEPPER=

# Cloudflare R2 is the required Worker upload storage path; retired legacy
# provider values are rejected at runtime.
ARCHESTIMATOR_UPLOAD_STORAGE_PROVIDER=cloudflare-r2
# Hosted upload runtime proof budgets for the Cloudflare Worker dry-run route.
ARCH_UPLOAD_HOSTED_MEMORY_MB=128
ARCH_UPLOAD_HOSTED_BODY_LIMIT_BYTES=4194304
ARCH_UPLOAD_HOSTED_ROUTE_DURATION_MS=30000
ARCH_UPLOAD_HOSTED_CONCURRENT_UPLOADS=3
ARCH_UPLOAD_STORAGE_LATENCY_P95_MS=250
# Set to cloudflare-images only when the local/preview IMAGES binding is ready to prove.
ARCHESTIMATOR_IMAGE_PROCESSING_PROVIDER=node-sharp
